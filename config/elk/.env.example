# Copy this file to .env and set real values before `docker compose up -d`.

# Pin to a specific current 8.x patch release at setup time (check
# https://www.elastic.co/downloads/elasticsearch for the latest 8.x tag).
STACK_VERSION=8.15.3

# Password for the built-in "elastic" superuser.
ELASTIC_PASSWORD=ChangeMe-Orion-2026!

# Password for the built-in "kibana_system" service account.
# Set this value on Elasticsearch AFTER the elasticsearch container is
# healthy, using set-kibana-system-password.sh, then start Kibana.
KIBANA_SYSTEM_PASSWORD=ChangeMe-Kibana-2026!

# Kibana saved-object encryption key (min 32 characters). Without it,
# Kibana Alerting refuses to create the detection rules.
# Generate one with: openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-hex-32
